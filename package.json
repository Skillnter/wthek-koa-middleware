{
  "name": "@wthek/koa-middleware",
  "version": "1.0.0",
  "description": "Production-safe Koa error-handling middleware for http-error-kit. Maps KitHttpError instances to structured JSON responses with correct HTTP status codes and optional logging.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "jest --config jest.config.ts",
    "build": "tsc --build",
    "coverage": "jest --coverage --config jest.config.ts",
    "prepublishOnly": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skillnter/wthek-koa-middleware.git"
  },
  "keywords": [
    "http",
    "error",
    "kit",
    "http-errors",
    "custom-errors",
    "error-handling",
    "koa",
    "koa2",
    "koa-middleware",
    "koa-error-handler",
    "koajs",
    "rest-api",
    "status-codes",
    "api-error",
    "json-error",
    "typescript",
    "middleware",
    "wthek",
    "skillnter"
  ],
  "author": "Himanshu Bansal <skillhimanshubansal@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/Skillnter/wthek-koa-middleware/issues"
  },
  "homepage": "https://github.com/Skillnter/wthek-koa-middleware#readme",
  "dependencies": {
    "http-error-kit": "^1.2.0",
    "http-response-status-code": "^1.8.0"
  },
  "peerDependencies": {
    "koa": "^2.0.0 || ^3.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.0",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "koa": "^2.15.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "@skillnter:registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "LICENSE"
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Skillnter"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/skillnter"
    },
    {
      "type": "open_collective",
      "url": "https://opencollective.com/skillnter"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://buymeacoffee.com/skillnter"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/skillhimanshubansal"
    }
  ]
}

